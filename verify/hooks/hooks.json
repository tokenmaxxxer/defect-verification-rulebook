{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/closed-checks-gate.sh"
          }
        ],
        "env": {
          "RECORD_FIELDS_TERMINAL_STATES": "cleared"
        }
      }
    ]
  }
}
